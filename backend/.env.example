# Copy to .env (Node: `npm run dev`, `npm run ask`) or .dev.vars (`npm run dev:worker`).
# Values with JSON in them must be on ONE line and wrapped in single quotes.

# ── Required ───────────────────────────────────────────────────────────────
# Shared secret the watch app sends as a bearer token. Generate: openssl rand -hex 32
KAI_API_KEY=
OPENAI_API_KEY=

# The projects Kai knows about. Every data source is optional per project.
#   ga4.propertyId        GA4 Admin → Property settings → Property ID (numeric)
#   posthog.projectId     PostHog → Project settings → Project ID (numeric)
#   posthog.revenueEvent  optional event that counts as a conversion; revenueProperty = its amount property
#   sentry.project        Sentry project slug (org comes from SENTRY_ORG unless set per project)
KAI_PROJECTS='[{"id":"shawgames","name":"ShawGames","aliases":["shaw games"],"ga4":{"propertyId":"123456789"},"posthog":{"projectId":"12345"},"sentry":{"project":"shawgames","environment":"production"}}]'

# ── Model ──────────────────────────────────────────────────────────────────
OPENAI_MODEL=gpt-5-mini
# Only for reasoning models (gpt-5 family). Remove it if you switch to a model that rejects it.
OPENAI_REASONING_EFFORT=low
# Speech-to-text for questions spoken on the watch.
OPENAI_TRANSCRIBE_MODEL=gpt-4o-mini-transcribe
# Used for "today" when the watch doesn't send its time zone.
KAI_TIMEZONE=America/New_York

# ── PostHog ────────────────────────────────────────────────────────────────
# Personal API key with the query:read scope (Account settings → Personal API keys).
POSTHOG_PERSONAL_API_KEY=
# https://us.posthog.com or https://eu.posthog.com (not the i.posthog.com ingestion host)
POSTHOG_HOST=https://us.posthog.com

# ── Sentry ─────────────────────────────────────────────────────────────────
# Auth token with org:read, project:read and event:read (Settings → Auth Tokens / Internal Integration).
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
# https://sentry.io, or https://de.sentry.io for EU-hosted orgs
SENTRY_BASE_URL=https://sentry.io

# ── Google Analytics 4 ─────────────────────────────────────────────────────
# Service-account key JSON on one line in single quotes, or base64 of the file
# (base64 -i key.json | tr -d '\n'). Add the service account's email as a Viewer on the GA4 property.
GA4_SERVICE_ACCOUNT_JSON=

# ── Supabase (optional) ────────────────────────────────────────────────────
# Stores conversation history. Without it, history is kept in memory (fine for local dev).
# Run supabase/migrations/0001_kai_conversations.sql first.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ── Local server ───────────────────────────────────────────────────────────
PORT=8787
# 127.0.0.1 = this Mac only (works with the watch simulator). 0.0.0.0 to reach it from a real watch on your Wi-Fi.
HOST=127.0.0.1
