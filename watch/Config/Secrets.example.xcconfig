// Copy to Config/Secrets.xcconfig (git-ignored) and fill in.

// Your Apple developer team ID (Xcode → Settings → Accounts) and a bundle id you own.
DEVELOPMENT_TEAM = ABCDE12345
KAI_BUNDLE_ID = com.yourname.kai

// Where the backend runs. Write "//" as "/$()/" because "//" starts an xcconfig comment.
//   Cloudflare Workers:  https:/$()/kai.your-subdomain.workers.dev
//   Mac on your Wi-Fi:   http:/$()/192.168.1.20:8787   (run the backend with HOST=0.0.0.0)
KAI_BASE_URL = https:/$()/kai.your-subdomain.workers.dev

// Same value as KAI_API_KEY in the backend's .env / Worker secrets.
KAI_API_KEY = paste-the-same-key-as-the-backend
